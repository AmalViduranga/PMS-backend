{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "IdentityUrl": "http://localhost:5001",
    "OperationsUrl": "http://localhost:5002",
    "CommerceUrl": "http://localhost:5003",
    "WorkforceUrl": "http://localhost:5004",
    "DocumentsUrl": "http://localhost:5005",
    "ReportingUrl": "http://localhost:5006"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "operations-branches-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/branches/{**catch-all}"
        }
      },
      "operations-catalogue-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/catalogue/{**catch-all}"
        }
      },
      "operations-shifts-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/shifts/{**catch-all}"
        }
      },
      "operations-pos-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/pos/{**catch-all}"
        }
      },
      "operations-inventory-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "operations-purchasing-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/purchasing/{**catch-all}"
        }
      },
      "commerce-route": {
        "ClusterId": "commerce-cluster",
        "Match": {
          "Path": "/api/commerce/{**catch-all}"
        }
      },
      "workforce-route": {
        "ClusterId": "workforce-cluster",
        "Match": {
          "Path": "/api/workforce/{**catch-all}"
        }
      },
      "documents-route": {
        "ClusterId": "documents-cluster",
        "Match": {
          "Path": "/api/documents/{**catch-all}"
        }
      },
      "reporting-route": {
        "ClusterId": "reporting-cluster",
        "Match": {
          "Path": "/api/reporting/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "operations-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "commerce-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "workforce-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "documents-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "reporting-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5006"
          }
        }
      }
    }
  }
}
