# PharmaFlow Local Infrastructure Configuration
# Copy this file to .env before starting containers

# Host Ports
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
AZURITE_BLOB_PORT=10000
MAILDEV_WEB_PORT=1080
MAILDEV_SMTP_PORT=1025

GATEWAY_PORT=5000
IDENTITY_PORT=5001
OPERATIONS_PORT=5002
COMMERCE_PORT=5003
WORKFORCE_PORT=5004
DOCUMENTS_PORT=5005
REPORTING_PORT=5006

# Superuser credentials for local development initialization
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_root_pwd

# RabbitMQ local credentials
RABBITMQ_DEFAULT_USER=pharmaflow
RABBITMQ_DEFAULT_PASS=rabbit_dev_pwd

# JWT Configuration (Downstream token signing)
JWT_SECRET=PharmaFlow_Ultra_Secure_Dev_Signing_Key_2026_AtLeast32Bytes!
JWT_ISSUER=PharmaFlow.Identity
JWT_AUDIENCE=PharmaFlow.Services
